rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if isSignedIn() && (
        request.auth.token.email == 'leviyathanindustries@gmail.com' || 
        request.auth.token.email == 'dayzer0to1.official@gmail.com'
      );
    }

    // --- Helpers ---
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isSignedIn() { return request.auth != null; } // Relaxed verification for dev
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'leviyathanindustries@gmail.com' || 
        request.auth.token.email == 'dayzer0to1.official@gmail.com'
      );
    }
    
    function isAdmin() {
      return isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    function isWhitelisted() {
      return isSuperAdmin() || exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // --- Validation Helpers ---
    
    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'sku', 'price', 'purchasePrice']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.sku is string && data.sku.size() > 0 &&
             data.price is number && data.price >= 0 &&
             data.purchasePrice is number && data.purchasePrice >= 0;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'role', 'email']) &&
             data.email is string && data.email.size() > 0 &&
             data.role in ['admin', 'manager', 'sales', 'inventory'];
    }

    function isValidSale(data) {
      return data.keys().hasAll(['id', 'items', 'totalAmount', 'paymentMethod', 'date']) &&
             data.totalAmount is number && data.totalAmount >= 0;
    }

    // --- Match Rules ---

    match /users/{userId} {
      allow get: if isSignedIn() && (isSuperAdmin() || request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if (isSuperAdmin() || isAdmin()) && isValidId(userId) && isValidUser(incoming());
      allow update: if (isSuperAdmin() || isAdmin()) && isValidUser(incoming());
      allow delete: if isSuperAdmin();
    }

    match /products/{productId} {
      allow read: if isWhitelisted();
      allow write: if isAdmin() && isValidId(productId) && (request.method == 'delete' || isValidProduct(incoming()));
    }

    match /sales/{saleId} {
      allow read: if isWhitelisted();
      allow create: if isWhitelisted() && isValidId(saleId) && isValidSale(incoming());
      allow delete: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read: if isWhitelisted();
      allow create: if isWhitelisted() && isValidId(expenseId);
      allow delete: if isAdmin();
    }

    match /purchases/{purchaseId} {
      allow read: if isWhitelisted();
      allow create: if isAdmin() && isValidId(purchaseId);
      allow delete: if isSuperAdmin();
    }

    match /daySummaries/{summaryId} {
      allow read: if isWhitelisted();
      allow write: if isAdmin() && isValidId(summaryId);
    }

    match /auditLogs/{logId} {
       allow read: if isAdmin();
       allow create: if isWhitelisted() && isValidId(logId);
    }

    match /config/{configId} {
      allow read: if isWhitelisted();
      allow write: if isAdmin();
    }
  }
}
