rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Primitives
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isSignedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'leviyathanindustries@gmail.com';
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin');
    }
    
    function isWhitelisted() {
      return isSuperAdmin() || exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // --- Collections ---

    // USERS: Whitelist and Profile
    match /users/{userId} {
      allow get: if isSignedIn() && (isSuperAdmin() || request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if (isSuperAdmin() || isAdmin()) && isValidId(userId);
      allow update: if (isSuperAdmin() || (isAdmin() && existing().role != 'admin')) && incoming().role in ['admin', 'manager', 'sales', 'inventory'];
      allow delete: if isSuperAdmin();
    }

    // PRODUCTS
    match /products/{productId} {
      allow read: if isWhitelisted();
      allow write: if isAdmin() && isValidId(productId);
    }

    // SALES
    match /sales/{saleId} {
      allow read: if isWhitelisted();
      allow create: if isWhitelisted() && isValidId(saleId);
      allow delete: if isAdmin();
    }

    // EXPENSES
    match /expenses/{expenseId} {
      allow read: if isWhitelisted();
      allow create: if isWhitelisted() && isValidId(expenseId);
      allow delete: if isAdmin();
    }

    // PURCHASES
    match /purchases/{purchaseId} {
      allow read: if isWhitelisted();
      allow create: if isAdmin() && isValidId(purchaseId);
      allow delete: if isSuperAdmin();
    }

    // DAY SUMMARIES
    match /daySummaries/{summaryId} {
      allow read: if isWhitelisted();
      allow write: if isAdmin() && isValidId(summaryId);
    }

    // AUDIT LOGS
    match /auditLogs/{logId} {
       allow read: if isAdmin();
       allow create: if isWhitelisted() && isValidId(logId);
    }

    // CONFIG
    match /config/{configId} {
      allow read: if isWhitelisted();
      allow write: if isAdmin();
    }
  }
}
